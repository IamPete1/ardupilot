# hw definition file for processing by chibios_hwdef.py for H757
# CubeNode pin descriptions can be found at https://docs.cubepilot.org/user-guides/cubenode/pin-descriptions

include ../CubeNode/hwdef.inc

# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID AP_HW_CUBENODE

# the H757 has 128k sectors; 1 sector for BL
FLASH_BOOTLOADER_LOAD_KB 128
FLASH_RESERVE_START_KB 128

# storage in flash
STORAGE_FLASH_PAGE 14
define HAL_STORAGE_SIZE 32768

# Ethernet is not broken out
undef ETH1 BOARD_PHY_ID BOARD_PHY_RMII
undef PC1 PA2 PC4 PC5 PB12 PB13 PB11 PA7 PA1

# CAN2
PB5 CAN2_RX CAN2
PB6 CAN2_TX CAN2

# SERIAL

# UART 1
PE1 UART8_TX UART8
PE0 UART8_RX UART8

# UART 2
PC6 USART6_TX USART6
PC7 USART6_RX USART6

# UART 3
undef PE7
undef PE8
PE7 UART7_RX UART7
PE8 UART7_TX UART7
PE10 UART7_CTS UART7
PE9 UART7_RTS UART7

undef SERIAL_ORDER
SERIAL_ORDER OTG1 UART8 USART6 UART7 OTG2

# I2C

# I2C 1
PA8 I2C3_SCL I2C3
PC9 I2C3_SDA I2C3

# I2C 2
PD12 I2C4_SCL I2C4
PD13 I2C4_SDA I2C4

I2C_ORDER I2C3 I2C4

# IMU on module (ICM-45686 on SPI3, SPIDEV defined in CubeNode/hwdef.inc)
IMU Invensensev3 SPI:icm45686 ROTATION_PITCH_180

# Baro and compass on I2C2 (I2C4, bus index 1 in I2C_ORDER)
BARO MS5611 I2C:1:0x77
COMPASS IST8310 I2C:1:0x0C false ROTATION_YAW_270

# LEDs
PB1 LED_BLUE OUTPUT LOW GPIO(0)
PA4 LED_GREEN OUTPUT LOW GPIO(1)
PE6 LED_RED OUTPUT LOW GPIO(2)

define AP_NOTIFY_GPIO_LED_3_ENABLED 1
define HAL_GPIO_A_LED_PIN 0
define HAL_GPIO_B_LED_PIN 1
define HAL_GPIO_C_LED_PIN 2

# pins for SD card:
PB14 SDMMC2_D0 SDMMC2
PB15 SDMMC2_D1 SDMMC2
PB3 SDMMC2_D2 SDMMC2
PB4 SDMMC2_D3 SDMMC2
PD6 SDMMC2_CK SDMMC2
PD7 SDMMC2_CMD SDMMC2

# Enable FAT filesystem support (needs a microSD defined via SDMMC).
define HAL_OS_FATFS_IO 1
define FATFS_HAL_DEVICE SDCD2

# Define some PWM pins. We also map these pins to GPIO
PE11 TIM1_CH2 TIM1 PWM(1) GPIO(50) BIDIR
PE13 TIM1_CH3 TIM1 PWM(2) GPIO(51) BIDIR
PE14 TIM1_CH4 TIM1 PWM(3) GPIO(52)
PA5  TIM2_CH1 TIM2 PWM(4) GPIO(53) BIDIR
PB10 TIM2_CH3 TIM2 PWM(5) GPIO(54) BIDIR
PB7  TIM4_CH2 TIM4 PWM(6) GPIO(55) BIDIR


# enable ADC for voltage / current monitoring
define HAL_USE_ADC TRUE

# Analog inputs

# ESC Thermistor
PF11 ADC_PIN ADC1 SCALE(1)

# Motor Thermistor
PC4 ADC_PIN ADC1 SCALE(1)

# Battery mid cell
PC0 ADC_PIN ADC1 SCALE(2)

# 5v rail analog input
PF5 VDD_5V_SENS ADC3 SCALE(2)

# This is the pin that senses USB being connected.
PA9 VBUS INPUT OPENDRAIN

# Power flag pins
PA6 VDD_BRICK_VALID INPUT PULLUP

# Enable power pin
PD15 IO_D15 OUTPUT GPIO(80) HIGH


